# ==============================================================================
# AI TradeQ Platform — Environment Variable Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to '.env' for local development.
# NEVER commit real credentials, secret keys, or production API tokens to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME="AI TradeQ SaaS Platform"
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
DEBUG=true
SECRET_KEY=change_this_to_a_secure_random_secret_in_development

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16+)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aitradeq_db
POSTGRES_USER=aitradeq_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql+asyncpg://aitradeq_user:your_secure_postgres_password_here@localhost:5432/aitradeq_db

# ------------------------------------------------------------------------------
# 3. Redis / Cache Configuration (Redis 7+)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 5. AI Providers & Vector Database
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
VECTOR_DB_URL=http://localhost:6333

# ------------------------------------------------------------------------------
# 6. External Financial & Market Data APIs
# ------------------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here

# ------------------------------------------------------------------------------
# 7. Logging Configuration
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=logs/app.log

# ------------------------------------------------------------------------------
# 8. Monitoring & Observability
# ------------------------------------------------------------------------------
SENTRY_DSN=your_sentry_dsn_here
PROMETHEUS_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
