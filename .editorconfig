# EditorConfig configuration for AI TradeQ
# http://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_size = 4

[*.{sh,bash}]
indent_size = 2
end_of_line = lf

[*.bat]
indent_size = 4
end_of_line = crlf

[*.{json,yaml,yml,md}]
indent_size = 2

[Makefile]
indent_style = tab
